# Copy this file to settings.env and fill it in. settings.env stays on your machine.
SEC_CONTACT="Your Name you@example.com"

# Which model does each job: claude, codex or kimi. Web steps need claude or codex.
FINDER_MODELS="codex"
DRAFTER="codex"
MAPPER="codex"
ASK_MODEL="codex"
WEB_MODEL="codex"
CLAUDE_MODEL="claude-opus-5-5"
CODEX_MODEL="gpt-6-astra"
CODEX_EFFORT="high"
KIMI_MODEL="kimi-code/k3-256k"

# Your account and situation, used for prices, sizing and tax notes
IBKR_ACCOUNT="U0000000"
IBKR_ACCOUNT_NOTE="UK Stocks and Shares ISA. No short selling or margin."
TAX_PROFILE="UK resident with a W-8BEN on file, investing through a Stocks and Shares ISA."
US_DIVIDEND_TAX_PCT="15"
INVESTOR_PROFILE="Describe your account size, time horizon and what you look for."

# Sizing rules
ISA_VALUE="3500"
MAX_POSITION_PCT="25"
CASH_RESERVE_PCT="20"
TRADE_COST_GBP="3"
GBPUSD="1.30"
WATCH_MIN_RETURN="20"
